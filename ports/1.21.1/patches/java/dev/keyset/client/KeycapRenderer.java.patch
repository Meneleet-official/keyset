+    private static TextBounds textBounds(Font font, String label) {
+        if (label == null || label.isEmpty()) return null;
+        int codepoint = label.codePointAt(0);
+        boolean cyrillic = label.codePointCount(0, label.length()) == 1
+            && Character.UnicodeScript.of(codepoint) == Character.UnicodeScript.CYRILLIC;
+        BitmapGlyphMetrics.Ink ink = cyrillic ? BitmapGlyphMetrics.measure(font, label)
+            : new BitmapGlyphMetrics.Ink(0, 0, Math.max(1, font.width(label)), font.lineHeight);
+        return new TextBounds(ink.left(), ink.top(), ink.width(), ink.height());
+    }
+
