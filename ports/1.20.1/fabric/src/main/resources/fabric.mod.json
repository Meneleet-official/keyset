{
  "schemaVersion": 1,
  "id": "keyset",
  "version": "${version}",
  "name": "Keyset",
  "description": "Visual key remapping with named hotkey profiles.",
  "icon": "assets/keyset/icon.png",
  "authors": ["Meneleet", "Macronux"],
  "license": "ISC",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.keyset.fabric.KeysetFabricClient"],
    "modmenu": ["dev.keyset.fabric.KeysetModMenu"]
  },
  "mixins": ["keyset.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": { "modmenu": "*", "malilib": "*" }
}
